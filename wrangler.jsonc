{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "truestay-tuesday",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "truestaytuesday.com", "custom_domain": true },
    { "pattern": "www.truestaytuesday.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
