{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "truestay-tuesday",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "truestaytuesday.com", "custom_domain": true },
    { "pattern": "www.truestaytuesday.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "PAY_DB",
      "database_name": "truestay-pay",
      "database_id": "4073abea-7d59-4667-aa50-7102e2ed983b",
      "migrations_dir": "migrations"
    },
    {
      "binding": "LOGS_DB",
      "database_name": "truestay-logs",
      "database_id": "fd1ee796-5e79-46d9-914c-c5f5f4623540"
    },
    {
      "binding": "CUT_DB",
      "database_name": "truestay-cut",
      "database_id": "d74ca09e-3e7a-45d0-9aa8-ab95f977d0ae"
    }
  ],
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true }
}
